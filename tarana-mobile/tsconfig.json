{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "paths": {
      "tarana-web/*": [
        "../src/lib/*"
      ],
      "tarana-web": [
        "../src/lib"
      ],
      "next/image": [
        "./shims/next-image.d.ts"
      ]
    }
  },
  "include": [
    ".",
    "../shims/**/*.d.ts",
    "nativewind-env.d.ts"
  ],
  // Own exclude (not inherited): root tsconfig excludes "tarana-mobile" to keep
  // the mobile tree out of the web program (duplicate React types). Without this
  // override that entry resolves against THIS dir and wipes its includes (TS18003).
  "exclude": [
    "node_modules"
  ]
}