# .npmrc - fetch/retry tuning shared by npm and pnpm.
# Installs are driven by pnpm (pnpm-lock.yaml); npm-only keys were removed.
# 1. Retry logic for transient network failures
fetch-retries=5
fetch-retry-factor=2
fetch-retry-maxtimeout=120000
fetch-retry-mintimeout=10000

# 2. Reduce logs
loglevel=warn
